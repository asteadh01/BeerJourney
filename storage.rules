rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'brewer-one@example.com',
          'brewer-two@example.com'
        ];
    }

    // Batch photos: anyone can view, only the two brewers can upload.
    match /brews/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024;
    }

    // Profile photos: public read, each brewer can only upload their own.
    match /profiles/{uid}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.auth.uid == uid &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
