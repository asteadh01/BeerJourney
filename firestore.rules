rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only the two brewer accounts may write. Add both Firebase Auth
    // emails here once the accounts exist (see README setup steps).
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'brewer-one@example.com',
          'brewer-two@example.com'
        ];
    }

    match /brews/{brewId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Brewer profile (display name, bio, avatar): public read for the About
    // page, but each brewer can only write their own document.
    match /profiles/{uid} {
      allow read: if true;
      allow write: if isAdmin() && request.auth.uid == uid;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() < 60 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() < 1000 &&
        request.resource.data.brewId is string;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
