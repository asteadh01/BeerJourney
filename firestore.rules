rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only the two brewer accounts may write.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'asteadh01@gmail.com',
          'arturo.amberg@gmail.com'
        ];
    }

    match /brews/{brewId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Brewer profile (display name, bio, avatar): public read for the About
    // page, but each brewer can only write their own document.
    match /profiles/{uid} {
      allow read: if true;
      allow write: if isAdmin() && request.auth.uid == uid;
    }

    // Fermentation gravity log: internal brewing notes, not the public
    // tasting/comments feed, so only the brewer can read or write it.
    match /gravityReadings/{readingId} {
      allow read, write: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() < 60 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() < 1000 &&
        request.resource.data.brewId is string;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
